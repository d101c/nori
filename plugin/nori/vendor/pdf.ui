<?xml version="1.0" encoding="UTF-8"?><interface><requires lib="gtk" version="4.0"/><template class="NoriPdfView" parent="AdwBin"><property name="child"><object class="GtkScrolledWindow"><property name="propagate-natural-height">true</property><property name="propagate-natural-width">true</property><property name="child"><object class="PpsView" id="view"><property name="model"><object class="PpsDocumentModel" id="model"><property name="annotation-model"><object class="PpsAnnotationModel"></object></property><property name="continuous">true</property><property name="sizing-mode">1</property><signal name="page-changed" handler="_updatePageLabel"/></object></property><property name="annotations-context"><object class="PpsAnnotationsContext"><property name="document-model">model</property><property name="undo-context"><object class="PpsUndoContext"><property name="document-model">model</property></object></property></object></property><property name="search-context"><object class="PpsSearchContext"><property name="document-model">model</property></object></property></object></property></object></property><child><object class="GtkShortcutController"><property name="scope">1</property><child><object class="GtkShortcut"><property name="trigger">&lt;Ctrl&gt;c</property><property name="action">action(pdf.copy)</property></object></child></object></child></template><object class="GtkBox" id="toolbar"><property name="halign">1</property><property name="valign">2</property><property name="spacing">18</property><style><class name="osd"/><class name="pill-osd"/></style><child><object class="GtkButton" id="toolbarBack"><property name="icon-name">go-previous-symbolic</property><signal name="clicked" handler="_goPreviousPage"/><accessibility><property name="label" translatable="yes">Previous Page</property></accessibility><style><class name="circular"/><class name="flat"/></style></object></child><child><object class="GtkLabel" id="pageLabel"><property name="visible">false</property><style><class name="numeric"/></style></object></child><child><object class="GtkButton" id="toolbarForward"><property name="icon-name">go-next-symbolic</property><signal name="clicked" handler="_goNextPage"/><accessibility><property name="label" translatable="yes">Next Page</property></accessibility><style><class name="circular"/><class name="flat"/></style></object></child></object></interface>